{
  "name": "dipesh-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/prerender/entry.tsx --outDir dist-server",
    "preview": "vite preview",
    "admin:reset-password": "node --env-file-if-exists=.env scripts/reset-password.mjs",
    "icons:slugs": "node scripts/gen-icon-slugs.mjs",
    "admin": "node --env-file-if-exists=.env server/index.mjs",
    "dev:full": "node --env-file-if-exists=.env scripts/dev-full.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "framer-motion": "^14.14.0",
    "lenis": "^1.3.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.38.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
