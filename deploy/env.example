# Names only. `sh bootstrap-env.sh <host> <admin email>` writes the real file,
# /docker/portfolio/.env (mode 600). Never commit values. APP_IMAGE is not here: release.env.
PORTFOLIO_HOST=
TRUST_PROXY=
# Optional: Traefik's address or subnet on the web network. Empty trusts any private peer.
TRUSTED_PROXY_IPS=
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
DB_PASSWORD=
BACKUP_DB_PASSWORD=
DATABASE_URL=
TRAEFIK_NETWORK=
