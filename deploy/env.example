# Names only. `sh bootstrap-env.sh <host> <admin email>` writes the real file,
# /docker/portfolio/.env (mode 600). Never commit values. APP_IMAGE is not here: release.env.
# The public host without www, for example the main domain. www.<host> redirects to it.
PORTFOLIO_HOST=
TRUST_PROXY=
# Required: Traefik's address (best, if fixed) or the subnet of the web network, /16 or
# narrower. docker network inspect web -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
TRUSTED_PROXY_IPS=
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
DB_PASSWORD=
BACKUP_DB_PASSWORD=
DATABASE_URL=
TRAEFIK_NETWORK=
# An existing shared volume only; add compose.shared-volume.yaml to COMPOSE_FILE.
# DATA_VOLUME=
# Shared PostgreSQL only (bootstrap-env.sh --shared-db); no POSTGRES_PASSWORD then.
# COMPOSE_FILE=compose.yaml:compose.shared-db.yaml
# DB_HOST=
# DB_NETWORK=
# DB_PORT=
