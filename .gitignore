# root-anchored: a bare data/ rule would also drop src/data/
/data/
node_modules/
dist/
dist-server/
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm
*.tsbuildinfo
*.log
.DS_Store
# local secrets, keys and database dumps
*.pem
*.key
*.p12
*.pfx
secrets.json
admin-credentials*
*.dump
*.dump.part

# backups, SQL dumps and archives (plural "backups": deploy/backup/ is source)
backups/
/*.sql
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zst
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
*.tgz
*.zip
*.7z
*.rar
*.bak

# tooling caches and coverage
__pycache__/
*.py[cod]
coverage/
.cache/
.vite/
.eslintcache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.trivycache/
.playwright-mcp/
playwright-report/
test-results/
.lighthouseci/
npm-debug.log*

# code-graph and agent tool output (machine-local)
graphify-out/
.codegraph/
.understand-anything/
.claude/settings.local.json

# macOS and editors
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
*.orig
*.rej
*.sublime-workspace
*.sublime-project

# archify run receipts (machine-local)
docs/diagrams/*.finalize*.json
docs/diagrams/*.browser-check.json
docs/diagrams/*.deliver*.json
docs/diagrams/*.delivery*.json
