# Portfolio. Copy to `.env` (git-ignored) and adjust. Local development needs nothing set.
# Production (`npm start` or the container) refuses to start without a database,
# TRUST_PROXY, PUBLIC_ORIGIN and, on an empty database, ADMIN_PASSWORD.

# --- Database ---------------------------------------------------------------
# PostgreSQL. Unset = SQLite at `data/portfolio.db` (development only).
# DATABASE_URL=postgres://portfolio_app:CHANGE_ME@127.0.0.1:5432/portfolio
# PG_POOL_MAX=10
# SQLite file, ignored when DATABASE_URL is set. In production it must be named
# explicitly (tests and a local production preview only).
# DSH_DB_FILE=./data/portfolio.db

# --- Owner account, created on first boot only ------------------------------
ADMIN_EMAIL=owner@example.com
ADMIN_NAME=Example Owner
# Required in production while there is no user; remove it after the first boot.
# In development, leave it unset to have one generated.
# ADMIN_PASSWORD=
# Folder for admin-credentials.txt (generated or reset password). Default: data/
# CREDENTIALS_DIR=./data

# --- Server -----------------------------------------------------------------
PORT=4319
HOST=127.0.0.1

# Number of reverse proxies in front of the API that append X-Forwarded-For.
# 0 = none. 1 = Traefik/nginx/Caddy. 2 = CDN then proxy. Required in production.
# Never set it higher than the real number: clients could then choose their own address.
# TRUST_PROXY=0

# Optional: only these addresses or subnets (the reverse proxy) may set the client
# address through X-Forwarded-For. Empty: any local or private peer.
# TRUSTED_PROXY_IPS=172.20.0.0/16

# Your public address, needed for sign-in and saving on a real domain. Required in
# production. Comma-separated, scheme included, no path. Localhost always works.
# PUBLIC_ORIGIN=https://example.com

# --- Development only -------------------------------------------------------
# Vite proxy target for /api and /content/site.json.
# ADMIN_ORIGIN=http://127.0.0.1:4319
